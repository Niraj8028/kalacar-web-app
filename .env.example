# Kalacar shop and API: settings
#
# How to use: copy this file to .env.local for your computer, and fill in your own values.
#             On Hostinger, add the same names under the shop site's Environment variables.
# Never put real values in this file, Git, chat, notes or screenshots. .env.local isn't uploaded.
# NEXT_PUBLIC_ settings are visible to anyone in the browser. Every other setting stays on the server.
#
# Each setting says:
#   SAME or DIFFERENT : whether development (your computer) and production (Hostinger) use one value
#   SECRET            : treat it like a password
# Full guide: kalacar_obsedian_voulte/21-production-settings.md

# ---- Database (MySQL): stores products, orders, customers, photos, pages and settings ----
# DIFFERENT. Development: srv2210.hstgr.io, and your internet address must be listed in Hostinger's
# Remote MySQL. Production: localhost, because the database is on the same server.
DB_HOST=
# SAME, usually 3306.
DB_PORT=3306
# DIFFERENT at launch: the real shop gets its own database. Also allow it in src/lib/catalogue-db.ts.
DB_NAME=
# DIFFERENT at launch, as above.
DB_USER=
# DIFFERENT at launch. SECRET.
DB_PASSWORD=
# Development only. A SEPARATE test database for `npm run qa`, which creates test orders. Never the shop's database.
# QA_DB_NAME=

# ---- Razorpay: takes payments ----
# DIFFERENT. rzp_test_ until launch. Checkout code refuses live keys until live payments are approved.
RAZORPAY_KEY_ID=
# DIFFERENT, matches the key above. SECRET. Create new ones if shared.
RAZORPAY_KEY_SECRET=
# DIFFERENT, one per webhook. SECRET. Lets Razorpay tell the shop about a payment directly. Empty turns the webhook off.
RAZORPAY_WEBHOOK_SECRET=

# ---- Google sign-in ----
# SAME while testing; a new client is recommended at launch. Every site address must be listed in Google Cloud.
GOOGLE_CLIENT_ID=
# Same as above. SECRET.
GOOGLE_CLIENT_SECRET=
# SAME: the Google accounts allowed into the dashboard, separated by commas. No spaces.
KALACAR_OWNER_EMAILS=

# ---- Site address ----
# DIFFERENT. Development: http://localhost:3000. Production: the shop's real address, starting https://.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Search engines ----
# Set to true ONLY at launch, then rebuild. Until then Google is told not to list the shop.
# DIFFERENT. Development: leave unset. Production: true after launch checks.
# KALACAR_ALLOW_SEARCH=true

# ---- Google Maps: "Use my current location" at checkout. Optional; customers can type their address. ----
# DIFFERENT. Shows the map. Visible in the browser, so restrict it to your site addresses in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# DIFFERENT. Turns the map pin into an address. SECRET. Needs billing enabled on the Google project.
GOOGLE_MAPS_SERVER_KEY=

# ---- Pusher: live updates to open pages, and real viewer counts. Optional; without it, pages use slower timers. ----
# Get these from Pusher > your app > App Keys.
# Can be SAME while testing. A separate Pusher app is recommended for the real shop.
PUSHER_APP_ID=
# Same as above. Visible to browsers, which is expected.
PUSHER_KEY=
# Same as above. SECRET. Create a new one in Pusher if shared.
PUSHER_SECRET=
# Same as above. ap2 is Mumbai.
PUSHER_CLUSTER=ap2

# ---- Browser pop-up alerts for new paid orders. Optional; without them, pop-ups stay off. ----
# DIFFERENT. Make a set with: npx web-push generate-vapid-keys
# If you change them, each device must turn alerts on again in dashboard Settings.
VAPID_PUBLIC_KEY=
# DIFFERENT, matches the public key. SECRET.
VAPID_PRIVATE_KEY=
# SAME. A contact address for the shop.
VAPID_SUBJECT=https://kalacar.in

# ---- Other ----
# SAME. Optional. Stock at or below this counts as low on the dashboard Overview. Default 3.
# The message on product pages is set separately in dashboard Settings.
KALACAR_LOW_STOCK_THRESHOLD=3
